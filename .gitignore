# Training
training/__pycache__/
training/**/__pycache__/
# Only IMAGE files inside training data directories are NOT tracked.
# Non-image artifacts (label tool, manifest JSON, .gitkeep) are tracked.
# Each developer trains their own model locally — see training/README.md.
training/samples/
# Trained model checkpoints
training/checkpoints/*.pt
training/data/

