# 013 决议：环境变量模板（复制为 .env 使用）
# 注意：默认凭据仅用于本地开发；生产必须覆盖。

# ── PostgreSQL ──
DB_USER=admin
DB_PASSWORD=123456
DB_NAME=bead_app

# ── 模型 artifact（010 R3）：宿主目录，只读挂载进 python-crnn ──
MODEL_ARTIFACT_HOST_DIR=./artifacts/models/current

# ── CORS（前端 dev server 地址）──
CORS_ALLOWED_ORIGINS=http://localhost:5173
